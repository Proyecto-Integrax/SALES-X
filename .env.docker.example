# Plantilla de configuración para docker compose.
# Lo normal es NO editarla: ejecute iniciar-docker.bat y genera .env.docker con secretos aleatorios.
# Si prefiere crearlo a mano, copie este archivo a .env.docker y reemplace cada valor.
POSTGRES_PASSWORD=REEMPLAZAR-contrasena-larga-solo-letras-y-numeros
APP_DB_PASSWORD=REEMPLAZAR-otra-contrasena-solo-letras-y-numeros
SECRET_KEY=REEMPLAZAR-clave-aleatoria-de-al-menos-32-caracteres
INTEGRATION_API_KEY=REEMPLAZAR-clave-aleatoria-de-al-menos-16-caracteres
ADMIN_EMAIL=admin@salesx.local
ADMIN_PASSWORD=REEMPLAZAR-contrasena-de-al-menos-10-caracteres-con-letras-y-numeros
