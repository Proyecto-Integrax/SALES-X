# ===== SALES-X - Configuración (copiar a .env y ajustar) =====

# development | production. En production la app se NIEGA a arrancar con claves por defecto o SQLite.
ENVIRONMENT=development

# Base de datos. Producción: PostgreSQL. Desarrollo local: SQLite (sin instalar nada).
# DATABASE_URL=postgresql+psycopg2://salesx:CAMBIAR@localhost:5432/salesx
DATABASE_URL=sqlite:///./sales_x.db

# Seguridad (OBLIGATORIO cambiar en producción; usar: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=cambiar-esta-clave-en-produccion
TOKEN_EXPIRE_MINUTES=480
# Clave del consumidor inicial «INTEGRAX-inicial». Las claves por sistema se crean en la pantalla Integraciones.
INTEGRATION_API_KEY=cambiar-api-key-integracion

# Negocio
IVA_RATE=0.19
# Zona horaria con la que se interpretan fechas de filtros y reportes (las fechas se guardan en UTC)
BUSINESS_TZ=America/Bogota

# Usuario administrador inicial (se crea una sola vez si no existe)
ADMIN_EMAIL=admin@salesx.local
ADMIN_PASSWORD=Admin2026*
ADMIN_NAME=Administrador SALES-X
# Crear además un vendedor de demostración (true/false). Desactivar en producción.
SEED_DEMO_USERS=true

# Integración con otros microproyectos de INTEGRAX
# simulado = catálogo de demostración interno | rest = consume los servicios REST de Clientes y Productos
CATALOGO_PROVIDER=simulado
CLIENTES_API_URL=http://localhost:8001/api/clientes
PRODUCTOS_API_URL=http://localhost:8002/api/productos
INTEGRATION_TIMEOUT_SECONDS=5

# CORS (lista separada por comas). Vacío = solo mismo origen.
CORS_ORIGINS=
